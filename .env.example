# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real keys.
# NEVER commit your real .env file or credentials to version control!
# ==============================================================================

# Roboflow API Key (Required for datagetimage.py to download datasets)
# Obtain your key from: https://app.roboflow.com/ -> Account Settings -> API Keys
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Sentinel AI Security (Optional)
# Set an API key if you want to require authentication on FastAPI /api/* routes
# If left empty, API authentication is disabled (development mode)
SENTINEL_API_KEY=

# CORS Allowed Origins (Optional, comma-separated URLs)
# Example: http://localhost:8000,http://127.0.0.1:8000
# Defaults to "*" (all origins) if omitted
SENTINEL_ALLOWED_ORIGINS=http://localhost:8000
